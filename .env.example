# Spotify app credentials for "paste a playlist link" import (server side only).
# Create an app at https://developer.spotify.com/dashboard and copy both values.
# On Vercel: Project Settings > Environment Variables. Locally: put them in .env.local.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Only for native (Capacitor) builds: the deployed site that hosts /api.
# VITE_API_BASE=https://your-app.vercel.app
